{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "meta context 2>/dev/null || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "agent --help 2>/dev/null | grep -q 'Claude Code agent toolkit' && agent guard; exit 0",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "meta context 2>/dev/null || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "git kb service status --quiet 2>/dev/null || git kb service start 2>/dev/null || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}